# =============================================================================
# .env.example — Template for environment variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit the .env file. It is listed in .gitignore.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence_db

# ─── NestJS Backend ──────────────────────────────────────────────────────────
# Mode: development | production | test
NODE_ENV=development
PORT=3001
# Generate with: openssl rand -hex 32  (64 characters minimum, backend refuses to start otherwise)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Elasticsearch / Logstash ────────────────────────────────────────────────
# Security is enabled in every environment. Secrets may only contain
# A-Z a-z 0-9 _ - (the setup script rejects anything else).
# Superuser: used only by the setup script and the healthcheck, never by a service.
ELASTIC_PASSWORD=change_me
# Least-privilege users created by elk/elasticsearch/setup.sh
LOGSTASH_ES_USER=logstash_writer
LOGSTASH_ES_PASSWORD=change_me
BACKEND_ES_USER=sentinel_reader
BACKEND_ES_PASSWORD=change_me
# Only needed when Kibana runs (not in development). Empty = not set.
KIBANA_SYSTEM_PASSWORD=

# ─── Backend outside Docker only ─────────────────────────────────────────────
# Inside Docker the compose file sets these from the values above and ignores
# the ones here. They are only read when the backend runs on your machine
# (cd backend && npm run start:dev): keep them in sync with the values above.
DATABASE_URL=postgresql://transcendence:changeme@postgres:5432/transcendence_db
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=sentinel_reader
# May stay empty while NODE_ENV=development
ELASTICSEARCH_PASSWORD=

# ─── VirusTotal API ──────────────────────────────────────────────────────────
# Free tier: 500 requests/day, 4 requests/min
# Get your key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ─── Nginx ───────────────────────────────────────────────────────────────────
# Everything is served by Nginx over HTTPS on the same origin, so the frontend
# uses relative paths (/api/v1, /socket.io) and needs no URL here.
# Name in the self-signed certificate. On the VPS, the real domain.
DOMAIN=localhost

# ─── 2FA ─────────────────────────────────────────────────────────────────────
TOTP_APP_NAME=Transcendence

# ─── Attack Simulator (development only) ─────────────────────────────────────
# Mode: basic | enriched | stress
# Rate: events per minute (1-1000). Empty uses the rate of the mode
# (basic 10, enriched 30, stress 200); a value overrides it for every mode.
SIMULATOR_MODE=basic
SIMULATOR_RATE=
