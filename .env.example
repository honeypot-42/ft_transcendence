# =============================================================================
# .env.example — Template for environment variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit the .env file. It is listed in .gitignore.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence_db

# ─── NestJS Backend ──────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Elasticsearch ───────────────────────────────────────────────────────────
# Leave empty in development (security disabled).
# Required in production (xpack.security.enabled=true).
ELASTIC_USER=elastic
ELASTIC_PASSWORD=

# ─── VirusTotal API ──────────────────────────────────────────────────────────
# Free tier: 500 requests/day, 4 requests/min
# Get your key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# ─── Nginx / SSL (production only) ───────────────────────────────────────────
DOMAIN=yourdomain.com
SSL_EMAIL=your@email.com

# ─── 2FA ─────────────────────────────────────────────────────────────────────
TOTP_APP_NAME=Transcendence

# ─── Attack Simulator (development only) ─────────────────────────────────────
# Mode: basic | enriched | stress
# Rate: attacks per minute
SIMULATOR_MODE=basic
SIMULATOR_RATE=10
